{
  "name": "openttd-web",
  "version": "0.0.0",
  "private": true,
  "description": "A faithful web implementation of OpenTTD with a colourful top-down look",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.sim.json && tsc -p tests/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings --ignore-pattern 'tests/architecture/sim-*.ts' --ignore-pattern 'tests/architecture/*-imports.ts'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^22.20.5",
    "happy-dom": "^21.0.1",
    "husky": "^9.1.7",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
